---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Build-time static timestamps
const buildDate = new Date();
const isoTimestamp = buildDate.toISOString();

// Formatted exact UTC string: e.g. "Nov 5, 2026, 17:34:28 UTC"
const exactUtcFormatted =
  buildDate.toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
    timeZone: 'UTC',
  }) + ' UTC';

// Initial relative time rendered at build time
const initialRelativeTime = 'just now';
---

<div class={`relative group/deploy inline-flex items-center ${className}`}>
  <!-- Interactive Trigger -->
  <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-zinc-400 cursor-default select-none">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
    <span class="text-zinc-400">Updated</span>
    <span
      id="deploy-relative-time"
      data-build-timestamp={isoTimestamp}
      class="text-zinc-600 border-b border-dotted border-zinc-300 group-hover/deploy:text-zinc-900 group-hover/deploy:border-zinc-500 transition-colors"
    >
      {initialRelativeTime}
    </span>
  </div>

  <!-- Pretty Light-Theme Popover Tooltip -->
  <div
    role="tooltip"
    class="pointer-events-none absolute bottom-full right-0 mb-2.5 z-30 flex flex-col rounded-xl border border-zinc-200/90 bg-white/95 p-3 text-xs font-mono shadow-xl shadow-zinc-900/10 backdrop-blur-md min-w-[240px] whitespace-nowrap opacity-0 invisible translate-y-1.5 scale-[0.98] group-hover/deploy:opacity-100 group-hover/deploy:visible group-hover/deploy:translate-y-0 group-hover/deploy:scale-100 transition-all duration-200 ease-out origin-bottom-right"
  >
    <!-- Tooltip Header -->
    <div class="flex items-center justify-between gap-3 pb-2 border-b border-zinc-100 text-[10px] uppercase tracking-wider text-zinc-400 font-semibold">
      <span class="flex items-center gap-1.5 text-emerald-600">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Last Deploy</span>
      </span>
    </div>

    <!-- Exact Timestamp Display -->
    <div class="py-2 space-y-1">
      <div class="text-[10px] text-zinc-400 uppercase tracking-wider">Exact UTC Time</div>
      <div class="text-xs font-medium text-zinc-900 flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{exactUtcFormatted}</span>
      </div>
    </div>

    <!-- Footer meta: Schedule / sync note -->
    <div class="pt-2 border-t border-zinc-100 flex items-center justify-between text-[10px] text-zinc-400">
      <span>Auto-sync schedule:</span>
      <span class="text-zinc-700 font-medium">01:00 & 13:00 UTC</span>
    </div>
  </div>
</div>

<script>
  function updateDeployRelativeTime() {
    const el = document.getElementById('deploy-relative-time');
    if (!el) return;

    const raw = el.getAttribute('data-build-timestamp');
    if (!raw) return;

    const buildTime = new Date(raw).getTime();
    if (isNaN(buildTime)) return;

    const diffSec = Math.max(0, Math.floor((Date.now() - buildTime) / 1000));

    let text = 'just now';
    if (diffSec < 60) {
      text = 'just now';
    } else {
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) {
        text = diffMin === 1 ? '1 minute ago' : `${diffMin} minutes ago`;
      } else {
        const diffHours = Math.floor(diffMin / 60);
        if (diffHours < 24) {
          text = diffHours === 1 ? '1 hour ago' : `${diffHours} hours ago`;
        } else {
          const diffDays = Math.floor(diffHours / 24);
          text = diffDays === 1 ? 'yesterday' : `${diffDays} days ago`;
        }
      }
    }

    el.textContent = text;
  }

  updateDeployRelativeTime();
  document.addEventListener('astro:page-load', updateDeployRelativeTime);
  // Periodically refresh relative time every 60 seconds
  setInterval(updateDeployRelativeTime, 60000);
</script>

