---
import { profileConfig } from '../config';
import type { Contribution } from '../types/contribution';
import Navbar from './Navbar.astro';
import ProfileAvatar from './ProfileAvatar.astro';
import SocialLinks from './SocialLinks.astro';
import MotivationCallout from './MotivationCallout.astro';
import WorkflowPipeline from './WorkflowPipeline.astro';
import StatsStrip from './StatsStrip.astro';

interface Props {
  contributions: Contribution[];
}

const { contributions } = Astro.props;
---

<Navbar />

<section class="mx-auto max-w-5xl px-4 sm:px-6 pt-10 pb-8 overflow-x-clip">
  <div class="flex flex-col sm:flex-row items-start gap-6">
    <ProfileAvatar />

    <!-- Profile Info & Description -->
    <div class="flex-1 space-y-3 min-w-0 max-w-full">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 font-sans leading-none">
          {profileConfig.name}
        </h1>

        <SocialLinks />
      </div>

      <p class="text-zinc-600 text-sm sm:text-base leading-relaxed max-w-3xl text-justify">
        {profileConfig.bio}
      </p>

      <!-- Motivation & Core Philosophy -->
      <MotivationCallout />

      <!-- Workflow summary pills with subtle animated energy pulse -->
      <WorkflowPipeline />
    </div>
  </div>

  <!-- Live Stats Strip -->
  <StatsStrip contributions={contributions} />
</section>
