---
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { profileConfig } from '../config';
import type { Contribution } from '../types/contribution';

interface Props {
  contributions: Contribution[];
}

const { contributions } = Astro.props;

// Calculate live aggregate stats from contributions
const totalMerged = contributions.filter((c) => c.status === 'merged').length;
const uniqueRepos = new Set(contributions.map((c) => c.repo)).size;
const totalAdditions = contributions.reduce((acc, c) => acc + (c.stats?.additions || 0), 0);
const totalDeletions = contributions.reduce((acc, c) => acc + (c.stats?.deletions || 0), 0);
const totalFilesChanged = contributions.reduce((acc, c) => acc + (c.stats?.filesChanged || 0), 0);
---

<header class="border-b border-zinc-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-30">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-3.5 flex items-center justify-between">
    <!-- Top breadcrumb / navigation -->
    <div class="flex items-center gap-2 text-sm font-mono text-zinc-600">
      <a
        href={profileConfig.links.website}
        class="flex items-center gap-1.5 hover:text-zinc-900 transition-colors group"
        title="Visit main website pere.sh"
      >
        <span class="text-zinc-400 group-hover:text-zinc-600 transition-colors">←</span>
        <span>pere.sh</span>
      </a>
      <span class="text-zinc-300">/</span>
      <span class="text-zinc-900 font-semibold">oss</span>
    </div>

    <!-- Right external links -->
    <div class="flex items-center gap-3">
      <a
        href={profileConfig.links.projectRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded-md text-zinc-600 hover:text-zinc-900 bg-zinc-100/70 hover:bg-zinc-100 border border-zinc-200/80 transition-colors shadow-2xs group"
        title="View project repository on GitHub"
      >
        <svg class="h-3.5 w-3.5 fill-current text-zinc-700 group-hover:text-zinc-900 transition-colors shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="font-medium">View on GitHub</span>
        <span class="text-zinc-400 group-hover:text-zinc-600 transition-colors text-[11px]">↗</span>
      </a>
    </div>
  </div>
</header>

<section class="mx-auto max-w-5xl px-4 sm:px-6 pt-10 pb-8">
  <div class="flex flex-col sm:flex-row items-start gap-6">
    <!-- Top-Left Avatar / Photo -->
    <!-- NOTE FOR PERE: To add your real photo, simply drop your image into public/avatar.jpg -->
    <div class="relative shrink-0 group">
      <div class="relative h-20 w-20 sm:h-24 sm:w-24 rounded-2xl overflow-hidden ring-2 ring-zinc-300 ring-offset-2 ring-offset-white bg-zinc-100 flex items-center justify-center shadow-md">
        <img
          src={profileConfig.avatarUrl}
          alt={profileConfig.name}
          class="h-full w-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <!-- Elegant fallback avatar displayed if avatar.jpg is not found -->
        <div class="hidden absolute inset-0 bg-gradient-to-br from-zinc-100 to-zinc-200 flex flex-col items-center justify-center text-zinc-700 font-mono">
          <span class="text-xl sm:text-2xl font-bold tracking-wider">{profileConfig.avatarFallbackInitials}</span>
          <span class="text-[9px] uppercase tracking-widest text-zinc-400 mt-0.5">DEV</span>
        </div>
      </div>
      <div class="absolute -bottom-1 -right-1 bg-emerald-500 border-2 border-white rounded-full h-4 w-4 shadow-xs" title="Active Contributor"></div>
    </div>

    <!-- Profile Info & Description -->
    <div class="flex-1 space-y-3">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 font-sans leading-none">
          {profileConfig.name}
        </h1>

        <!-- Social links next to name -->
        <div class="flex items-center gap-1 translate-y-0.5">
          {profileConfig.links.github && (
            <a
              href={profileConfig.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center p-1.5 rounded-md text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 transition-colors"
              title="GitHub Profile"
              aria-label="GitHub Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox={`0 0 ${faGithub.icon[0]} ${faGithub.icon[1]}`} aria-hidden="true">
                <path d={faGithub.icon[4] as string} />
              </svg>
            </a>
          )}
          {profileConfig.links.linkedin && (
            <a
              href={profileConfig.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center p-1.5 rounded-md text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 transition-colors"
              title="LinkedIn Profile"
              aria-label="LinkedIn Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox={`0 0 ${faLinkedin.icon[0]} ${faLinkedin.icon[1]}`} aria-hidden="true">
                <path d={faLinkedin.icon[4] as string} />
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Description: Clean placeholder in English as requested, customizable anytime -->
      <p class="text-zinc-600 text-sm sm:text-base leading-relaxed max-w-3xl">
        {profileConfig.bio}
      </p>

      <!-- Workflow summary pills with subtle animated energy pulse -->
      <div id="pipeline-flow-container" class="relative pt-3 flex flex-wrap items-center gap-2.5 text-xs font-mono text-zinc-600 overflow-visible">
        <!-- Dual Electric Sparks with Comet Trail (Animated) -->
        <div id="pipeline-spark-top" class="pipeline-spark" aria-hidden="true"></div>
        <div id="pipeline-spark-bottom" class="pipeline-spark" aria-hidden="true"></div>

        <!-- AI Agent Stage -->
        <div id="flow-group-agent" class="relative flex items-center gap-2 px-3 py-2 rounded-lg border border-dashed border-zinc-300 bg-white/40 transition-colors duration-300">
          <span class="absolute -top-2 left-2.5 px-1 bg-[#fafafa] text-[10px] font-mono uppercase tracking-wider text-indigo-600 font-semibold">
            AI Agent
          </span>
          <span
            id="flow-step-discovery"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white border border-zinc-200 shadow-2xs text-zinc-700 transition-all duration-300"
          >
            <svg class="h-3.5 w-3.5 text-indigo-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
            Issue Discovery
          </span>
          <span class="text-zinc-400">→</span>
          <span
            id="flow-step-implementation"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white border border-zinc-200 shadow-2xs text-zinc-700 transition-all duration-300"
          >
            <svg class="h-3.5 w-3.5 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            Implementation
          </span>
        </div>

        <span class="text-zinc-400 font-medium">→</span>

        <!-- Human Stage -->
        <div id="flow-group-human" class="relative flex items-center gap-2 px-3 py-2 rounded-lg border border-dashed border-zinc-300 bg-white/40 transition-colors duration-300">
          <span class="absolute -top-2 left-2.5 px-1 bg-[#fafafa] text-[10px] font-mono uppercase tracking-wider text-amber-700 font-semibold">
            Human
          </span>
          <span
            id="flow-step-verification"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white border border-zinc-200 shadow-2xs text-zinc-700 transition-all duration-300"
          >
            <svg class="h-3.5 w-3.5 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            Verification
          </span>
          <span class="text-zinc-400">→</span>
          <span
            id="flow-step-merged"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-purple-50 border border-purple-200 text-purple-700 shadow-2xs font-medium transition-all duration-300 origin-center"
          >
            <!-- Clean Git Merge Icon -->
            <svg class="h-3.5 w-3.5 text-purple-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="18" r="3"></circle>
              <circle cx="6" cy="6" r="3"></circle>
              <path d="M6 21V9a9 9 0 0 0 9 9"></path>
            </svg>
            Merged to Production
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Stats Strip -->
  <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-white border border-zinc-200/90 rounded-xl p-3 sm:p-4 shadow-xs">
      <div class="text-xs font-mono uppercase tracking-wider text-zinc-500">Merged PRs</div>
      <div class="mt-1 text-2xl font-bold font-mono text-purple-700">{totalMerged}</div>
      <div class="text-[11px] text-zinc-400 mt-0.5">Approved & live in production</div>
    </div>

    <div class="bg-white border border-zinc-200/90 rounded-xl p-3 sm:p-4 shadow-xs">
      <div class="text-xs font-mono uppercase tracking-wider text-zinc-500">Repositories</div>
      <div class="mt-1 text-2xl font-bold font-mono text-zinc-900">{uniqueRepos}</div>
      <div class="text-[11px] text-zinc-400 mt-0.5">Open source codebases</div>
    </div>

    <div class="bg-white border border-zinc-200/90 rounded-xl p-3 sm:p-4 shadow-xs">
      <div class="text-xs font-mono uppercase tracking-wider text-zinc-500">Diff Impact</div>
      <div class="mt-1 flex items-baseline gap-1.5 flex-wrap">
        <span class="text-2xl font-bold font-mono text-emerald-600">+{totalAdditions}</span>
        <span class="text-rose-500 text-lg font-medium font-mono">-{totalDeletions}</span>
        {totalFilesChanged > 0 && (
          <span class="text-xs font-mono text-zinc-400 font-normal">
            ({totalFilesChanged} files)
          </span>
        )}
      </div>
      <div class="text-[11px] text-zinc-400 mt-0.5">Across all contributions</div>
    </div>

    <div class="bg-white border border-zinc-200/90 rounded-xl p-3 sm:p-4 shadow-xs">
      <div class="text-xs font-mono uppercase tracking-wider text-zinc-500">Delivery Model</div>
      <div class="mt-1 text-base sm:text-lg font-bold font-mono text-blue-700 flex items-center gap-1.5 mt-1.5">
        <span>Agent + Review</span>
      </div>
      <div class="text-[11px] text-zinc-400 mt-0.5">Autonomous with human oversight</div>
    </div>
  </div>
</section>

<style>
  /* Electric Sparks with Comet Trail */
  .pipeline-spark {
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5px;
    height: 3.5px;
    margin-left: -1.75px;
    margin-top: -1.75px;
    border-radius: 9999px;
    background-color: #ffffff;
    box-shadow:
      0 0 3px 1px #ffffff,
      0 0 6px 1.5px #818cf8,
      -3px 0 5px 1px rgba(99, 102, 241, 0.8),
      -7px 0 7px 1px rgba(168, 85, 247, 0.5),
      -12px 0 9px 1.5px rgba(168, 85, 247, 0.25);
    pointer-events: none;
    z-index: 30;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Pipeline Energy Pulse Highlights */
  .flow-glow-indigo {
    border-color: rgba(99, 102, 241, 0.7) !important;
    box-shadow: 0 0 14px 1px rgba(99, 102, 241, 0.35), 0 1px 3px rgba(0, 0, 0, 0.05) !important;
    background-color: #faf5ff !important;
    transform: translateY(-1.5px) scale(1.02);
  }

  .flow-glow-blue {
    border-color: rgba(59, 130, 246, 0.7) !important;
    box-shadow: 0 0 14px 1px rgba(59, 130, 246, 0.35), 0 1px 3px rgba(0, 0, 0, 0.05) !important;
    background-color: #eff6ff !important;
    transform: translateY(-1.5px) scale(1.02);
  }

  .flow-glow-amber {
    border-color: rgba(245, 158, 11, 0.7) !important;
    box-shadow: 0 0 14px 1px rgba(245, 158, 11, 0.35), 0 1px 3px rgba(0, 0, 0, 0.05) !important;
    background-color: #fffbeb !important;
    transform: translateY(-1.5px) scale(1.02);
  }

  .flow-celebrate {
    border-color: rgba(168, 85, 247, 0.85) !important;
    box-shadow: 0 0 20px 3px rgba(168, 85, 247, 0.45), 0 4px 8px rgba(168, 85, 247, 0.2) !important;
    background-color: #f3e8ff !important;
    transform: translateY(-2px) scale(1.07);
  }
</style>

<script>
  function setupPipelineAnimation() {
    const container = document.getElementById('pipeline-flow-container');
    const sparkTop = document.getElementById('pipeline-spark-top');
    const sparkBottom = document.getElementById('pipeline-spark-bottom');
    const stepDiscovery = document.getElementById('flow-step-discovery');
    const stepImplementation = document.getElementById('flow-step-implementation');
    const stepVerification = document.getElementById('flow-step-verification');
    const stepMerged = document.getElementById('flow-step-merged');

    if (!container || !sparkTop || !sparkBottom || !stepDiscovery || !stepImplementation || !stepVerification || !stepMerged) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let isRunning = false;

    function runCycle() {
      if (document.hidden || isRunning) return;
      isRunning = true;

      const cRect = container!.getBoundingClientRect();
      const getRel = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        const left = r.left - cRect.left;
        const top = r.top - cRect.top;
        return {
          left,
          top,
          right: left + r.width,
          bottom: top + r.height,
          cx: left + r.width / 2,
          cy: top + r.height / 2,
        };
      };

      const d = getRel(stepDiscovery!);
      const i = getRel(stepImplementation!);
      const v = getRel(stepVerification!);
      const m = getRel(stepMerged!);

      const pad = 0.5;

      // Helper to generate the parallel rail segments for any card
      const getRails = (r: ReturnType<typeof getRel>) => {
        const topY = r.top - pad;
        const bottomY = r.bottom + pad;

        const topPoints = [
          { x: r.left, y: r.cy, opacity: 1 },
          { x: r.left + 3, y: topY, opacity: 1 },
          { x: r.cx, y: topY, opacity: 1 },
          { x: r.right - 3, y: topY, opacity: 1 },
          { x: r.right, y: r.cy, opacity: 1 },
        ];

        const bottomPoints = [
          { x: r.left, y: r.cy, opacity: 1 },
          { x: r.left + 3, y: bottomY, opacity: 1 },
          { x: r.cx, y: bottomY, opacity: 1 },
          { x: r.right - 3, y: bottomY, opacity: 1 },
          { x: r.right, y: r.cy, opacity: 1 },
        ];

        return { topPoints, bottomPoints };
      };

      // Helper for bridge segments between cards (sparks travel as 1 unified point)
      const getBridge = (r1: ReturnType<typeof getRel>, r2: ReturnType<typeof getRel>) => {
        const midX = (r1.right + r2.left) / 2;
        const midY = (r1.cy + r2.cy) / 2;
        const pts = [
          { x: r1.right, y: r1.cy },
          { x: midX, y: midY },
          { x: r2.left, y: r2.cy },
        ];
        return {
          topPoints: pts.map(p => ({ ...p, opacity: 1 })),
          bottomPoints: pts.map(p => ({ ...p, opacity: 0 })), // Bottom hides on wire bridges so it looks like 1 spark
        };
      };

      // Gentle wandering spawn far to the left
      const startX = d.left - 50;
      const startY = d.cy - 10;
      const startFloat = [
        { x: startX, y: startY },
        { x: startX + 12, y: startY - 12 },
        { x: startX + 24, y: startY + 14 },
        { x: startX + 36, y: startY - 6 },
        { x: d.left, y: d.cy },
      ];

      const r1 = getRails(d);
      const b1 = getBridge(d, i);
      const r2 = getRails(i);
      const b2 = getBridge(i, v);
      const r3 = getRails(v);
      const b3 = getBridge(v, m);
      const r4 = getRails(m);

      // Assemble complete top and bottom keyframe streams
      const topStream = [
        ...startFloat.map(p => ({ ...p, opacity: p === startFloat[0] ? 0 : 1, scale: 1 })),
        ...r1.topPoints.map(p => ({ ...p, scale: 1 })),
        ...b1.topPoints.map(p => ({ ...p, scale: 1 })),
        ...r2.topPoints.map(p => ({ ...p, scale: 1 })),
        ...b2.topPoints.map(p => ({ ...p, scale: 1 })),
        ...r3.topPoints.map(p => ({ ...p, scale: 1 })),
        ...b3.topPoints.map(p => ({ ...p, scale: 1 })),
        ...r4.topPoints.map(p => ({ ...p, scale: 1 })),
        // Sparks meet at the right edge and cleanly fade out at their normal tiny size
        { x: m.right, y: m.cy, opacity: 1, scale: 1 },
        { x: m.right, y: m.cy, opacity: 0, scale: 1 },
      ];

      const bottomStream = [
        ...startFloat.map(p => ({ ...p, opacity: 0, scale: 1 })), // Hidden before reaching card 1
        ...r1.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...b1.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...r2.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...b2.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...r3.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...b3.bottomPoints.map(p => ({ ...p, scale: 1 })),
        ...r4.bottomPoints.map(p => ({ ...p, scale: 1 })),
        // Sparks meet at the right edge and cleanly fade out at their normal tiny size
        { x: m.right, y: m.cy, opacity: 1, scale: 1 },
        { x: m.right, y: m.cy, opacity: 0, scale: 1 },
      ];

      const topKeyframes = topStream.map(pt => ({
        transform: `translate3d(${pt.x}px, ${pt.y}px, 0) scale(${pt.scale})`,
        opacity: pt.opacity,
      }));

      const bottomKeyframes = bottomStream.map(pt => ({
        transform: `translate3d(${pt.x}px, ${pt.y}px, 0) scale(${pt.scale})`,
        opacity: pt.opacity,
      }));

      // Calmer, longer pace (~12.6s total journey)
      const duration = 12600;

      sparkTop!.animate(topKeyframes, {
        duration,
        easing: 'linear',
        fill: 'forwards',
      });

      const animB = sparkBottom!.animate(bottomKeyframes, {
        duration,
        easing: 'linear',
        fill: 'forwards',
      });

      // Synchronize glowing stage auras as current passes through
      // Step 1: ~12% to ~28%
      setTimeout(() => stepDiscovery?.classList.add('flow-glow-indigo'), duration * 0.12);
      setTimeout(() => stepDiscovery?.classList.remove('flow-glow-indigo'), duration * 0.28);

      // Step 2: ~34% to ~50%
      setTimeout(() => stepImplementation?.classList.add('flow-glow-blue'), duration * 0.34);
      setTimeout(() => stepImplementation?.classList.remove('flow-glow-blue'), duration * 0.50);

      // Step 3: ~56% to ~72%
      setTimeout(() => stepVerification?.classList.add('flow-glow-amber'), duration * 0.56);
      setTimeout(() => stepVerification?.classList.remove('flow-glow-amber'), duration * 0.72);

      // Step 4: ~78% entry, then celebration pulse at the moment they fuse at the right edge (~96%)!
      setTimeout(() => {
        stepMerged?.classList.add('flow-celebrate');
      }, duration * 0.96);

      setTimeout(() => {
        stepMerged?.classList.remove('flow-celebrate');
      }, duration * 0.96 + 1400);

      animB.onfinish = () => {
        isRunning = false;
      };
    }

    // Initial trigger after 1.8s
    setTimeout(runCycle, 1800);

    // Repeat with longer pause between runs: 12.6s journey + 6.5s rest = 19.1s cycle
    const intervalId = setInterval(runCycle, 19100);

    document.addEventListener('astro:before-swap', () => clearInterval(intervalId), { once: true });
  }

  setupPipelineAnimation();
  document.addEventListener('astro:page-load', setupPipelineAnimation);
</script>
