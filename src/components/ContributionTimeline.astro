---
import type { Contribution } from '../types/contribution';

interface Props {
  contribution: Contribution;
  dateLabel?: string;
}

const { contribution, dateLabel } = Astro.props;

// Determine primary display date based on PR status
const relevantDateStr =
  (contribution.status === 'merged' ? contribution.mergedAt : null) ||
  (contribution.status === 'closed' ? contribution.closedAt : null) ||
  contribution.createdAt ||
  contribution.updatedAt ||
  contribution.mergedAt;

const formatDateNice = (dStr: string) => {
  return new Date(dStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const formattedDate = relevantDateStr ? formatDateNice(relevantDateStr) : 'Recent';

// Default label fallback if not passed
const displayLabel = dateLabel || (
  contribution.status === 'merged'
    ? 'Merged'
    : contribution.status === 'closed'
    ? 'Closed'
    : contribution.status === 'draft'
    ? 'Drafted'
    : 'Opened'
);

// Calculate turnaround duration for merged PRs
function getTurnaround(startStr?: string | null, endStr?: string | null) {
  if (!startStr || !endStr) return null;
  const start = new Date(startStr).getTime();
  const end = new Date(endStr).getTime();
  const diffDays = Math.round((end - start) / (1000 * 60 * 60 * 24));
  if (diffDays <= 0) return 'Same-day merge';
  if (diffDays === 1) return 'Merged in 1 day';
  return `Merged in ${diffDays} days`;
}

// Assemble chronological lifecycle steps for the git-graph popover
interface LifecycleStep {
  type: 'opened' | 'updated' | 'merged' | 'closed';
  label: string;
  date: string;
  rawDate: string;
  dotClass: string;
}

const steps: LifecycleStep[] = [];

if (contribution.createdAt) {
  steps.push({
    type: 'opened',
    label: 'Opened',
    rawDate: contribution.createdAt,
    date: formatDateNice(contribution.createdAt),
    dotClass: 'bg-emerald-500',
  });
}

// For active/in-flight PRs (open or draft), display the latest activity timestamp
if (contribution.status === 'open' || contribution.status === 'draft') {
  if (contribution.updatedAt && contribution.updatedAt !== contribution.createdAt) {
    steps.push({
      type: 'updated',
      label: 'Last active',
      rawDate: contribution.updatedAt,
      date: formatDateNice(contribution.updatedAt),
      dotClass: 'bg-blue-500',
    });
  }
}

if (contribution.mergedAt) {
  steps.push({
    type: 'merged',
    label: 'Merged',
    rawDate: contribution.mergedAt,
    date: formatDateNice(contribution.mergedAt),
    dotClass: 'bg-purple-600',
  });
} else if (contribution.closedAt) {
  steps.push({
    type: 'closed',
    label: 'Closed',
    rawDate: contribution.closedAt,
    date: formatDateNice(contribution.closedAt),
    dotClass: 'bg-rose-500',
  });
}

// Guarantee chronological ordering
steps.sort((a, b) => new Date(a.rawDate).getTime() - new Date(b.rawDate).getTime());

const turnaround = contribution.status === 'merged'
  ? getTurnaround(contribution.createdAt, contribution.mergedAt)
  : null;
---

<div class="relative group/timeline inline-flex items-center">
  <!-- Date trigger with subtle interactive affordance -->
  <time
    datetime={relevantDateStr || ''}
    class="text-zinc-600 flex items-center gap-1.5 cursor-default group-hover/timeline:text-zinc-900 transition-colors select-none"
  >
    <span class="text-zinc-400 font-normal">{displayLabel}</span>
    <span class="border-b border-dotted border-zinc-300 group-hover/timeline:border-zinc-500 transition-colors">
      {formattedDate}
    </span>
  </time>

  <!-- Handcrafted Light Popover with Git-style Connected Rail -->
  {steps.length > 0 && (
    <div
      role="tooltip"
      class="pointer-events-none absolute bottom-full left-0 mb-2.5 z-30 flex flex-col rounded-xl border border-zinc-200/90 bg-white/95 p-3.5 text-xs font-mono shadow-xl shadow-zinc-900/10 backdrop-blur-md min-w-[250px] whitespace-nowrap opacity-0 invisible translate-y-1.5 scale-[0.98] group-hover/timeline:opacity-100 group-hover/timeline:visible group-hover/timeline:translate-y-0 group-hover/timeline:scale-100 transition-all duration-200 ease-out origin-bottom-left"
    >
      <!-- Popover Header -->
      <div class="flex items-center justify-between gap-3 pb-2.5 border-b border-zinc-100 text-[10px] uppercase tracking-wider text-zinc-400 font-semibold">
        <span class="flex items-center gap-1.5">
          <svg class="h-3 w-3 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>Timeline</span>
        </span>
        <span class="text-zinc-400 font-normal">#{contribution.prNumber}</span>
      </div>

      <!-- Connected Vertical Git Track -->
      <div class="relative flex flex-col gap-2.5 pt-2.5 pl-4">
        <!-- Vertical connecting line -->
        {steps.length > 1 && (
          <div class="absolute left-[3.5px] top-[14px] bottom-[14px] w-[1.5px] bg-zinc-200" aria-hidden="true"></div>
        )}

        {steps.map((step) => (
          <div class="relative flex items-center justify-between gap-4">
            <!-- Node on the track -->
            <div class="absolute -left-4 flex items-center justify-center">
              <span class={`h-2 w-2 rounded-full ring-2 ring-white ${step.dotClass}`}></span>
            </div>

            <span class="text-[11px] font-medium text-zinc-700">{step.label}</span>
            <span class="text-[11px] text-zinc-500 font-normal">{step.date}</span>
          </div>
        ))}
      </div>

      <!-- Turnaround Footer (if available) -->
      {turnaround && (
        <div class="mt-3 pt-2.5 border-t border-zinc-100 flex items-center justify-between gap-4 text-[11px]">
          <span class="text-zinc-400 text-[10px] uppercase tracking-wider shrink-0">Turnaround</span>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-purple-700 bg-purple-50/90 px-2 py-0.5 rounded-md border border-purple-200/70 shrink-0 shadow-2xs">
            <svg class="h-3 w-3 text-purple-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>{turnaround}</span>
          </span>
        </div>
      )}

      <!-- Seamless light arrow notch -->
      <div class="absolute -bottom-1.5 left-5 h-3 w-3 rotate-45 border-r border-b border-zinc-200/90 bg-white"></div>
    </div>
  )}
</div>
