---
import type { Contribution } from '../types/contribution';
import LanguageIcon from './LanguageIcon.astro';

interface Props {
  contribution: Contribution;
}

const { contribution } = Astro.props;

// Format merged date nicely (e.g., "Oct 26, 2026")
const formattedDate = new Date(contribution.mergedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article
  class="contribution-card group relative flex flex-col justify-between rounded-xl border border-zinc-200/90 bg-white p-5 transition-all duration-200 hover:border-zinc-300 hover:shadow-md"
  data-repo={contribution.repo.toLowerCase()}
  data-title={contribution.prTitle.toLowerCase()}
  data-lang={contribution.language.toLowerCase()}
>
  <!-- Card Header: Repo info + Merged status badge -->
  <div>
    <div class="flex items-center justify-between gap-3 text-xs font-mono">
      <a
        href={contribution.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-zinc-600 hover:text-zinc-900 transition-colors truncate"
        title={`View repository ${contribution.repo}`}
      >
        <!-- Crisp Repository / Codebase Icon -->
        <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400 group-hover:text-zinc-600 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
        </svg>
        <span class="truncate font-medium">{contribution.repo}</span>
      </a>

      <!-- GitHub-style Merged Badge with Crisp Git Merge Icon -->
      <span class="inline-flex items-center gap-1.5 shrink-0 rounded-full bg-purple-50 px-2.5 py-0.5 text-[11px] font-medium text-purple-700 border border-purple-200 shadow-2xs">
        <svg class="h-3.5 w-3.5 shrink-0 text-purple-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="18" r="3"></circle>
          <circle cx="6" cy="6" r="3"></circle>
          <path d="M6 21V9a9 9 0 0 0 9 9"></path>
        </svg>
        <span>Merged</span>
        <span class="text-purple-600/80 font-mono">#{contribution.prNumber}</span>
      </span>
    </div>

    <!-- PR Title -->
    <h3 class="mt-3 text-base font-semibold tracking-tight text-zinc-900 group-hover:text-blue-600 transition-colors">
      <a
        href={contribution.prUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="focus:outline-none focus:ring-1 focus:ring-blue-500 rounded inline-flex items-center gap-1.5 group/link"
      >
        <span>{contribution.prTitle}</span>
        <svg class="h-3.5 w-3.5 opacity-0 -translate-x-1 group-hover/link:opacity-100 group-hover/link:translate-x-0 transition-all text-blue-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </h3>
  </div>

  <!-- Card Footer: Language Badge & Metrics -->
  <div class="mt-5 pt-3.5 border-t border-zinc-100 flex flex-col gap-2.5">
    <!-- Clean Language Badge with SVG icon after text -->
    <div class="flex items-center">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-blue-50/80 px-2 py-0.5 text-[11px] font-mono font-medium text-blue-700 border border-blue-200/80">
        <span>{contribution.language}</span>
        <LanguageIcon language={contribution.language} />
      </span>
    </div>

    <!-- Date & Diff Stats -->
    <div class="flex items-center justify-between text-xs font-mono text-zinc-500 pt-0.5">
      <time datetime={contribution.mergedAt} class="text-zinc-600">
        {formattedDate}
      </time>

      {contribution.stats && (
        <div class="flex items-center gap-1.5">
          {contribution.stats.additions > 0 && (
            <span class="text-emerald-600 font-medium">+{contribution.stats.additions}</span>
          )}
          {contribution.stats.deletions > 0 && (
            <span class="text-rose-600 font-medium">-{contribution.stats.deletions}</span>
          )}
          {contribution.stats.filesChanged && (
            <span class="text-[11px] text-zinc-400 font-normal">
              ({contribution.stats.filesChanged} {contribution.stats.filesChanged === 1 ? 'file' : 'files'})
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</article>
