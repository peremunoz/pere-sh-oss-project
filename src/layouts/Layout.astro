---
import '../styles/global.css';
import { profileConfig } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profileConfig.name} | Open Source Contributions (oss.pere.sh)`,
  description = profileConfig.siteDescription,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://oss.pere.sh');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://pere.sh/#person',
      name: profileConfig.name,
      url: profileConfig.links.website,
      sameAs: [
        profileConfig.links.github,
        profileConfig.links.linkedin,
      ].filter(Boolean),
      jobTitle: 'Software Engineer & Open Source Contributor',
      description: profileConfig.bio,
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://oss.pere.sh/#webpage',
      url: 'https://oss.pere.sh/',
      name: title,
      description: description,
      about: { '@id': 'https://pere.sh/#person' },
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://oss.pere.sh/#website',
        name: 'oss.pere.sh',
        url: 'https://oss.pere.sh/',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <link rel="apple-touch-icon" href="/avatar.jpg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- AI Agent & LLM Discovery (llms.txt standard) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Full Context" />

    <!-- Schema.org JSON-LD for AI Search & Crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="min-h-screen bg-[#fafafa] text-zinc-900 antialiased selection:bg-blue-600 selection:text-white overflow-x-clip">
    <div class="fixed inset-0 bg-grid pointer-events-none opacity-60 z-0"></div>
    <div class="relative z-10 flex min-h-screen flex-col overflow-x-clip">
      <slot />
    </div>
  </body>
</html>
