---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContributionsGrid from '../components/ContributionsGrid.astro';
import Footer from '../components/Footer.astro';
import { profileConfig } from '../config';
import contributionsData from '../data/contributions.json';
import type { Contribution } from '../types/contribution';

// Load and cast contributions data
const rawContributions = contributionsData as Contribution[];

// Sort newest first by most relevant date (mergedAt, closedAt, updatedAt, or createdAt)
const getContributionTime = (c: Contribution) => {
  const dateStr = c.mergedAt || c.closedAt || c.updatedAt || c.createdAt;
  return dateStr ? new Date(dateStr).getTime() : 0;
};

const contributions = [...rawContributions].sort((a, b) => {
  return getContributionTime(b) - getContributionTime(a);
});
---

<Layout
  title={profileConfig.siteTitle}
  description={profileConfig.siteDescription}
>
  <Header contributions={contributions} />
  <main class="flex-1 flex flex-col">
    <ContributionsGrid contributions={contributions} />
  </main>
  <Footer />
</Layout>
